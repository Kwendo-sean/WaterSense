#include <Arduino.h>
#line 1 "C:\\Users\\seank\\OneDrive\\Desktop\\WaterSense\\scripts\\arduino\\ESP32_Hardware_Diagnostic\\ESP32_Hardware_Diagnostic.ino"
#include <Wire.h>
#include <U8g2lib.h>
#include <Adafruit_NeoPixel.h>

// WaterSense ESP32-S3 N16R8 hardware diagnostic.
// Pump relay 1 is deliberately NEVER energized by this sketch.

#define WATER_SENSOR_PIN 4
#define OLED_SDA_PIN 8
#define OLED_SCL_PIN 9
#define RELAY_PUMP_PIN 16
#define ULTRASONIC_TRIG_PIN 17
#define ULTRASONIC_ECHO_PIN 18
#define RELAY_2_PIN 21
#define BUZZER_PIN 42
#define RGB_LED_PIN 48

// The common two-channel relay board is active LOW.
const int RELAY_OFF = HIGH;
const int RELAY_ON = LOW;

U8G2_SH1106_128X64_NONAME_F_HW_I2C oled(
  U8G2_R0, U8X8_PIN_NONE, OLED_SCL_PIN, OLED_SDA_PIN
);
Adafruit_NeoPixel rgb(1, RGB_LED_PIN, NEO_GRB + NEO_KHZ800);

float readDistanceCm() {
  digitalWrite(ULTRASONIC_TRIG_PIN, LOW);
  delayMicroseconds(3);
  digitalWrite(ULTRASONIC_TRIG_PIN, HIGH);
  delayMicroseconds(20);
  digitalWrite(ULTRASONIC_TRIG_PIN, LOW);
  unsigned long duration = pulseIn(ULTRASONIC_ECHO_PIN, HIGH, 60000);
  return duration == 0 ? -1.0f : duration * 0.0343f / 2.0f;
}

void setRgb(uint8_t red, uint8_t green, uint8_t blue) {
  rgb.setPixelColor(0, rgb.Color(red, green, blue));
  rgb.show();
}

void showResult(float distance, int waterRaw) {
  char line[28];
  oled.clearBuffer();
  oled.setFont(u8g2_font_6x10_tr);
  oled.drawStr(0, 9, "WATERSENSE DIAGNOSTIC");
  oled.drawHLine(0, 12, 128);
  if (distance < 0) {
    oled.drawStr(0, 27, "Ultrasonic: NO ECHO");
  } else {
    snprintf(line, sizeof(line), "Distance: %.1f cm", distance);
    oled.drawStr(0, 27, line);
  }
  snprintf(line, sizeof(line), "Water raw: %d", waterRaw);
  oled.drawStr(0, 41, line);
  oled.drawStr(0, 54, "Pump relay: LOCKED OFF");
  oled.drawStr(0, 64, "COM10 @ 115200");
  oled.sendBuffer();
}

void setup() {
  // Relay outputs are established first. Relay 1 remains off for the entire test.
  pinMode(RELAY_PUMP_PIN, OUTPUT);
  pinMode(RELAY_2_PIN, OUTPUT);
  digitalWrite(RELAY_PUMP_PIN, RELAY_OFF);
  digitalWrite(RELAY_2_PIN, RELAY_OFF);

  pinMode(BUZZER_PIN, OUTPUT);
  digitalWrite(BUZZER_PIN, LOW);
  pinMode(WATER_SENSOR_PIN, INPUT);
  pinMode(ULTRASONIC_TRIG_PIN, OUTPUT);
  pinMode(ULTRASONIC_ECHO_PIN, INPUT);
  digitalWrite(ULTRASONIC_TRIG_PIN, LOW);

  Serial.begin(115200);
  delay(800);
  Serial.println("WATERSENSE_DIAGNOSTIC_START");
  Serial.println("PUMP_RELAY_1=LOCKED_OFF");

  rgb.begin();
  rgb.setBrightness(25);
  setRgb(40, 0, 0); delay(250);
  setRgb(0, 40, 0); delay(250);
  setRgb(0, 0, 40); delay(250);
  setRgb(0, 0, 0);
  Serial.println("RGB_TEST=COMPLETE");

  oled.setBusClock(100000);
  oled.begin();
  Serial.println("OLED_INIT=COMPLETE");

  tone(BUZZER_PIN, 1800, 180);
  delay(250);
  noTone(BUZZER_PIN);
  digitalWrite(BUZZER_PIN, LOW);
  Serial.println("BUZZER_TEST=COMPLETE");

  // Channel 2 is intended to be unloaded. One short click tests its control path.
  digitalWrite(RELAY_2_PIN, RELAY_ON);
  delay(180);
  digitalWrite(RELAY_2_PIN, RELAY_OFF);
  Serial.println("RELAY_2_PULSE=COMPLETE");
}

void loop() {
  digitalWrite(RELAY_PUMP_PIN, RELAY_OFF);
  float distance = readDistanceCm();
  int waterRaw = analogRead(WATER_SENSOR_PIN);

  Serial.print("DISTANCE_CM=");
  if (distance < 0) Serial.print("NO_ECHO");
  else Serial.print(distance, 1);
  Serial.print(" WATER_RAW=");
  Serial.print(waterRaw);
  Serial.println(" PUMP_RELAY_1=OFF");

  if (distance < 0) setRgb(40, 0, 0);
  else if (waterRaw > 400) setRgb(40, 20, 0);
  else setRgb(0, 40, 0);

  showResult(distance, waterRaw);
  delay(1000);
}

