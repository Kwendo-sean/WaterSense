# Copy to /opt/watersense/.env and fill in. chmod 600 it.
# Compose reads this file automatically from the project directory.

# --- which compose file plain `docker compose ...` uses on the server -------
COMPOSE_FILE=docker-compose.prod.yml
COMPOSE_PROJECT_NAME=watersense

# --- public identity --------------------------------------------------------
# Must match the host nginx server_name and the cert. Baked into the frontend
# bundle at build time (VITE_API_URL / VITE_WS_URL), so changing it needs a
# rebuild - deploy.sh always rebuilds.
DOMAIN=watersense.selenos.world

# Loopback port the host nginx proxies to. Change it if 8770 is taken on the
# box, and change `upstream watersense_web` in nginx-watersense.conf to match.
WEB_PORT=8770

# --- database (container-local, no host port published) ---------------------
POSTGRES_DB=watersense
POSTGRES_USER=watersense
# REQUIRED. Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- app behaviour ----------------------------------------------------------
# The demo telemetry simulator. Set to false once real devices/Arduino nodes
# are posting to /api/v1/telemetry, otherwise synthetic readings mix with real.
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=3

TZ=Africa/Nairobi
